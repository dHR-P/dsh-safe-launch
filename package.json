{
  "name": "dsh-safe-launch",
  "version": "0.1.2",
  "description": "DSH 安全启动器插件：按上次成功配置启动；核心更新只提示、用户同意后才后台下载并金丝雀验证（新版核心×全部插件）；安装新插件前自动兼容性测试；看门狗监控绕过安装。Safe launcher for DeepSeek Harness: last-good boot config, consent-gated canary updates, compatibility-checked plugin installation, manifest watchdog.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./restart-helper": "./lib/restart-helper.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "safe-launch",
    "updater",
    "canary",
    "compatibility"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2"
  },
  "repository": "github:dHR-P/dsh-safe-launch",
  "license": "MIT"
}
